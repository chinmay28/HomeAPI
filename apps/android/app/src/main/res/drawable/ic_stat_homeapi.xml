<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon: the house from frontend/public/icon.svg as a
     silhouette. Android draws a notification's small icon as a single-colour
     mask, so the artwork would show as a blank square; this is the same
     shapes — the roof, and the card with its two key/value rows cut out —
     redrawn by hand on the 24dp grid (the SVG's 512 units × 24/512). If the
     artwork changes shape, redraw it to match. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- The roof -->
    <path
        android:pathData="M92,242 L256,104 L420,242"
        android:strokeWidth="40"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The card, with the rows cut through it -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
