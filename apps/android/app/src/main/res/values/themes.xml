<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark with the phone, like the web GUI's own theme. -->
    <style name="Theme.HomeAPI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/homeapi_primary</item>
        <item name="colorOnPrimary">@color/homeapi_on_primary</item>
        <item name="colorSecondary">@color/homeapi_accent</item>
        <item name="android:colorBackground">@color/homeapi_bg</item>
        <item name="colorSurface">@color/homeapi_surface</item>
        <item name="android:windowBackground">@color/homeapi_bg</item>
    </style>

    <!-- No window action bar: the screen has its own toolbar, which it can
         keep out from under the status bar on an edge-to-edge Android. -->
    <style name="Theme.HomeAPI.Settings" parent="Theme.HomeAPI">
        <item name="colorSurface">@color/homeapi_bg</item>
    </style>

    <style name="Theme.HomeAPI.Invisible" parent="Theme.HomeAPI">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
